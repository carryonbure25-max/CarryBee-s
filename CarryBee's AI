(()=>{const q=s=>document.querySelector(s),qa=s=>[...document.querySelectorAll(s)];let mode='auto',listening=false;for(let i=0;i<32;i++){const e=document.createElement('i');e.style.height=25+Math.random()*70+'%';e.style.animationDelay=Math.random()*.8+'s';q('#bars').append(e)}function escape(s){return s.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}function add(role,text){const el=document.createElement('div');el.className='message '+role;el.innerHTML='<div class="meta">'+(role==='user'?'YOU / INPUT':'CARRY B’S AI / CORE')+'</div><p>'+escape(text)+'</p>';q('#conversation').append(el);q('#conversation').scrollTop=q('#conversation').scrollHeight}function setMode(next){mode=next;qa('[data-mode]').forEach(b=>b.classList.toggle('active',b.dataset.mode===next));q('#route').textContent=next==='auto'?'AUTO ROUTE':next==='online'?'ONLINE LINK':'LOCAL ONLY';q('#modeCopy').textContent=next==='offline'?'No network request will be sent. Local interface remains active.':next==='online'?'Route requests through the connected intelligence layer.':'Use the best available route while keeping state visible.'}function speak(text){if(!('speechSynthesis' in window))return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.rate=.96;u.pitch=.86;u.volume=.9;speechSynthesis.speak(u)}function localReply(text){const t=text.toLowerCase();if(/hello|hi\b|hey/.test(t))return 'Hello. Carry B’s AI is online at the interface layer and ready for your request.';if(/what can you do|capabilit|help/.test(t))return 'I can answer through a connected AI endpoint, speak responses aloud, switch operating modes, show telemetry, and keep sensitive local actions permission-gated.';if(/status|system report|telemetry/.test(t))return 'System status: command deck ready, telemetry stream active, microphone standby, and permission layer armed.';if(/who are you|your name/.test(t))return 'I am Carry B’s AI, a visible command-deck assistant designed to keep connection and permission states clear.';if(/offline|local/.test(t))return 'Offline mode is enabled. No network request will be sent; the local interface and installed local adapters remain available.';if(/online|internet|web/.test(t))return 'Online mode is selected. Add a secure AI endpoint to route this request to a connected language model.';return 'I received your request. Online mode can send it to a connected AI endpoint, while offline mode can answer only through installed local adapters.'}async function onlineReply(text){const endpoint=localStorage.getItem('carryEndpoint')||q('#endpoint').value.trim();if(!endpoint)throw new Error('Online mode needs an AI endpoint. Add your secure backend URL in the Online AI Endpoint field.');const response=await fetch(endpoint,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({message:text,mode:'online',assistant:'Carry B’s AI'})});if(!response.ok)throw new Error('The online AI endpoint returned '+response.status+'.');const data=await response.json();return data.text||data.response||data.message||'The online endpoint returned no text response.'}async function submit(raw){const text=(raw||q('#input').value).trim();if(!text)return;q('#input').value='';add('user',text);q('#coreState').textContent='PROCESSING';let answer;try{if(/offline/i.test(text)){setMode('offline');answer=localReply(text)}else if(mode==='offline'){answer=localReply(text)}else{answer=await onlineReply(text)}}catch(error){answer=error.message+' You can switch to OFFLINE for local demo responses.'}add('core',answer);speak(answer);q('#coreState').textContent='READY'}q('#endpoint').value=localStorage.getItem('carryEndpoint')||'';q('#saveEndpoint').onclick=()=>{const endpoint=q('#endpoint').value.trim();if(endpoint)localStorage.setItem('carryEndpoint',endpoint);add('core',endpoint?'Online endpoint saved locally in this browser.':'Online endpoint cleared.');};q('#enter').onclick=()=>q('#startup').remove();q('#offlineStart').onclick=()=>{setMode('offline');q('#startup').remove()};q('#capStart').onclick=()=>{q('#startup').remove();q('.right .panel:nth-child(3)').scrollIntoView({behavior:'smooth'})};q('#send').onclick=()=>submit();q('#input').onkeydown=e=>{if(e.key==='Enter')submit()};qa('[data-command]').forEach(b=>b.onclick=()=>submit(b.dataset.command));qa('[data-mode]').forEach(b=>b.onclick=()=>setMode(b.dataset.mode));q('#mic').onclick=()=>{listening=!listening;q('#mic').classList.toggle('active',listening);q('#micState').textContent=listening?'LISTENING':'STANDBY';q('#coreState').textContent=listening?'LISTENING':'READY'};setInterval(()=>{q('#clock').textContent=new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})+' LOCAL';const cpu=24+Math.round(Math.random()*28),mem=44+Math.round(Math.random()*12),lat=32+Math.round(Math.random()*18);q('#cpu').textContent=cpu+'%';q('#memory').textContent=mem+'%';q('#latency').textContent=lat+' ms';q('#cpuMeter').style.width=cpu+'%';q('#memoryMeter').style.width=mem+'%';q('#latencyMeter').style.width=lat+'%'},2400)})();
